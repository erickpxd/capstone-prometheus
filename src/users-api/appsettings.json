{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=prometheus-auth.db"
  },
  "Jwt": {
    "Issuer": "Prometheus.Users.Api",
    "Audience": "Prometheus.Portal.Web",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
